MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_USER_ID=@aineko:example.org
MATRIX_PASSWORD=your_password_here
MATRIX_ROOM_ID=!room1:example.org

# Kimi K2.5 via Moonshot API (recommended)
LLM_PROVIDER=litellm
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=moonshot/kimi-k2.5
LLM_THINKING=true
LLM_TEMPERATURE=1.0
LLM_TOP_P=0.95
LLM_MAX_TOKENS=32000
LLM_MAX_CONTEXT_TOKENS=262144

# Kimi Coding API (alternative — uses Anthropic-compatible endpoint)
#LLM_BASE_URL=https://api.kimi.com/coding/v1
#LLM_MODEL=anthropic/kimi-for-coding
#LLM_USER_AGENT=claude-code/0.1.0

# ChatGPT Plus/Pro via OpenCode OAuth auth.json mount
#LLM_PROVIDER=opencode-openai
#LLM_MODEL=openai/gpt-5.5
#LLM_OPENCODE_AUTH_PATH=/opencode-auth/auth.json

AINEKO_BRAVE_API_KEY=BSA...

AINEKO_LOG_LEVEL=info
